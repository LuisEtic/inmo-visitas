# Copia este archivo como .env y rellena los valores reales.
# Nunca subas .env a Git: está excluido en .gitignore.

# URL del proyecto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública (anon) de Supabase
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Cliente (todo lo que cambia por cliente vive en src/config/client.ts)
VITE_CLIENT_NAME=Inmo Visitas
VITE_CLIENT_LOGO_URL=
VITE_CLIENT_PRIMARY_COLOR=#111111
# CRM de destino: inmovilla | witei | whatsapp | manual
VITE_CLIENT_CRM_TARGET=manual

# Ruta de publicación. Déjalo en / para Coolify con dominio propio.
# Solo para GitHub Pages: VITE_BASE_PATH=/inmo-visitas/
VITE_BASE_PATH=/
